# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Cloudflare Worker URL
# Get this after deploying: wrangler deploy
STORAGE_WORKER_URL=https://graphics-compiler-users-worker.your-subdomain.workers.dev

# Discord Webhook (Optional - for contact form)
# Create webhook in Discord: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Google OAuth (Optional - configured in Supabase)
# These are stored in Supabase, not needed in .env
# Client_ID=your_google_client_id
# Client_secret=your_google_client_secret
