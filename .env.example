# ============================================================================
#  graphics.h Online Compiler — Environment Variables
# ============================================================================
#  These are used ONLY at build time by build.py to render static HTML.
#  For secrets (Discord webhook, etc.), use Cloudflare Worker secrets instead.
# ============================================================================

# ─── Build-Time Variables (baked into HTML) ─────────────────────────
# The domain where the site is hosted. Used for canonical URLs, OG tags, sitemap.
SITE_DOMAIN=https://graphics-h-compiler.vercel.app

# URL of your R2 public assets worker (for videos, zip files, demos).
# Leave empty to skip asset URL injection.
PUBLIC_ASSETS_URL=

# Google OAuth Client ID. This is public (visible in browser anyway).
# Required for the "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# Date shown on the maintenance page.
MAINTENANCE_DATE=25 Feb 2026 · 2:00 PM IST

# ─── Worker Secrets (NOT used by build.py) ──────────────────────────
# These are set on the graphics-oc-api Worker via `wrangler secret put`.
# They are listed here for reference only. Do NOT put actual values here.
#
#   DISCORD_WEBHOOK_URL  — Discord channel webhook for contact/feedback
#   USER_FILES_WORKERS   — URL of the graphics-oc-files Cloudflare Worker
#   GOOGLE_CLIENT_ID     — Also set on the Worker for /api/auth/config
