# ============================================================================
#  graphics.h Online Compiler — Environment Variables
# ============================================================================
#  Copy this file to `.env` and fill in the values.
#  Only USER_FILES_WORKERS + GOOGLE_CLIENT_ID + SESSION_SECRET are needed
#  for the full cloud-storage experience. Everything else is optional.
# ============================================================================

# ─── Core ───────────────────────────────────────────────────────────
# Set to "true" to redirect all traffic to a maintenance splash page.
MAINTENANCE_MODE=false

# ─── Cloud File Storage Worker ──────────────────────────────────────
# URL of your deployed `graphics-oc-files` Cloudflare Worker.
# This worker handles user authentication and file CRUD.
# Leave empty to run in guest-only mode (files saved to browser only).
USER_FILES_WORKERS=

# ─── Public Assets Worker ───────────────────────────────────────────
# URL for serving public assets (videos, zip files, demos).
# Leave empty to serve these assets directly from the local Vercel deployment.
PUBLIC_ASSETS_URL=

# ─── Google OAuth ───────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Required for the "Sign in with Google" button.
# Without this, the sign-in UI is hidden and the compiler runs in guest mode.
GOOGLE_CLIENT_ID=

# ─── Session Secret ─────────────────────────────────────────────────
# A cryptographically random string (64+ chars) used to sign session JWTs
# that the Flask proxy passes between the browser and the files worker.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ─── Discord Webhook (Optional) ─────────────────────────────────────
# Used by the /contact form and the maintenance-page message endpoint.
# If empty, the contact form returns a 500 error.
DISCORD_WEBHOOK_URL=
