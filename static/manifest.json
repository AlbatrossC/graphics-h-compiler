{
    "version": "1.0.0",
    "description": "Resource manifest for graphics.h online compiler - supports online/offline modes with fallback URLs",
    "libs": {
        "jsdos": {
            "name": "JS-DOS",
            "urls": [
                "https://js-dos.com/6.22/current/js-dos.js"
            ],
            "localPath": "/libs/js-dos.js"
        },
        "wdosbox": {
            "name": "WDOSBOX",
            "urls": [
                "https://js-dos.com/6.22/current/wdosbox.js"
            ],
            "localPath": "/libs/wdosbox.js"
        },
        "codemirror": {
            "name": "CodeMirror Editor",
            "type": "module",
            "urls": [],
            "localPath": "/libs/codemirror-bundle.js",
            "note": "CodeMirror 6 loaded as ES module in editor.js"
        },
        "tailwindcss": {
            "name": "Tailwind CSS",
            "urls": [
                "https://cdn.tailwindcss.com"
            ],
            "localPath": null,
            "required": false
        },
        "lucide": {
            "name": "Lucide Icons",
            "urls": [
                "https://unpkg.com/lucide@latest"
            ],
            "localPath": "/libs/lucide.min.js",
            "required": false
        }
    },
    "assets": {
