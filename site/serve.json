{
  "headers": [
    {
      "source": "static/build/compiler.*.@(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    },
    {
      "source": "@(libs|compiler-assets/libs)/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    },
    {
      "source": "@(libs|compiler-assets/libs)/**/*.wasm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        },
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    },
    {
      "source": "compiler-assets/zip-files/*.zip",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    },
    {
      "source": "static/@(fonts|images|audio|videos|assets)/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    },
    {
      "source": "static/js/compiler/codemirror.bundle.v1.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    },
    {
      "source": "static/html/dos-runner.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    },
    {
      "source": "static/@(css|js)/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "**/*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "@(robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "**",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
