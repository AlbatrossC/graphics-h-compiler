# ============================================================================
#  Cloudflare Pages - Cache & Security Headers
#  https://developers.cloudflare.com/pages/configuration/headers/
# ============================================================================

# ---------------------------------------------------------------------------
# Immutable, cache-busted compiler bundles
# ---------------------------------------------------------------------------
/static/build/compiler.*.css
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform
/static/build/compiler.*.js
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform

# ---------------------------------------------------------------------------
# Runtime libraries. /libs/* is rewritten to /compiler-assets/libs/*.
# These filenames are treated as vendored/version-pinned assets.
# ---------------------------------------------------------------------------
/libs/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform
/compiler-assets/libs/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform
/libs/*.wasm
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform
  Content-Type: application/wasm
/compiler-assets/libs/*.wasm
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform
  Content-Type: application/wasm

# ---------------------------------------------------------------------------
# Versioned compiler filesystem zip. Keep this as sticky as possible because
# app.js caches it client-side and the filename includes the version.
# ---------------------------------------------------------------------------
/compiler-assets/zip-files/*.zip
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform
  Content-Disposition: attachment

# ---------------------------------------------------------------------------
# Fonts and versioned/static media assets
# ---------------------------------------------------------------------------
/static/fonts/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform
/static/images/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform
/static/audio/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform
/static/videos/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform
/static/vendor/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform

# ---------------------------------------------------------------------------
# Versioned JSON data bundles
# ---------------------------------------------------------------------------
/static/assets/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform

# ---------------------------------------------------------------------------
# Versioned standalone runtime files
# ---------------------------------------------------------------------------
/static/js/compiler/codemirror.bundle.v1.js
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform
/static/html/dos-runner.html
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, no-transform

# ---------------------------------------------------------------------------
# Non-hashed CSS/JS entry files. Keep these cacheable, but revalidatable.
# ---------------------------------------------------------------------------
/static/css/*
  Cache-Control: public, max-age=604800, s-maxage=604800, must-revalidate
/static/js/*
  Cache-Control: public, max-age=604800, s-maxage=604800, must-revalidate

# ---------------------------------------------------------------------------
# Manifests and root metadata should reflect deploys quickly.
# ---------------------------------------------------------------------------
/static/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
/static/build/asset-manifest.json
  Cache-Control: public, max-age=0, must-revalidate
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------------------
