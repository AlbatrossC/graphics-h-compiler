{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "r2-public-assets",
	"main": "src/index.js",
	"compatibility_date": "2026-01-28",
	"observability": {
		"enabled": true
	},
	/**
	 * R2 Bucket Binding
	 * This connects your Worker to the R2 bucket
	 */
	"r2_buckets": [
		{
			"binding": "ASSETS_BUCKET",
			"bucket_name": "graphics-compiler-public"
		}
	]
}