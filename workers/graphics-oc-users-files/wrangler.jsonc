{
  "name": "graphics-oc-users-files",
  "main": "src/index.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": true,
  "preview_urls": false,

  "vars": {
    "WORKER_URL": "https://graphics-oc-users-files.albatrossc.workers.dev",
    "FRONTEND_URL": "http://localhost:5173"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graphics-compiler-db",
      "database_id": "313005f3-83a1-459f-9827-9ecc9db6a051"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "graphics-compiler-users"
    }
  ],

  "observability": {
    "enabled": true
  }
}