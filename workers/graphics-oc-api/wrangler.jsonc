{
  "name": "graphics-oc-api",
  "main": "worker.js",
  "compatibility_date": "2026-05-26",

  "kv_namespaces": [
    {
      "binding": "MAINTENANCE_KV",
      "id": "9c060181c3184231949421f4ed905d9b"
    }
  ],

  "services": [
    {
      "binding": "USER_FILES_WORKER",
      "service": "graphics-oc-files"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "MAINTENANCE_CHAT_ROOM",
        "class_name": "MaintenanceChatRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MaintenanceChatRoom"]
    }
  ],

  // Secrets — set via CLI, never in this file:
  //   npx wrangler secret put DISCORD_WEBHOOK_URL
  //   npx wrangler secret put GOOGLE_CLIENT_ID
  //   npx wrangler secret put SUPABASE_REST_CONFIG
  //   npx wrangler secret put MAINTENANCE_ADMIN_TOKEN
  //
  // Optional vars:
  //   MAINTENANCE_SESSION_SLUG: e.g. "2026-06-25-thursday"
  "vars": {}
}
