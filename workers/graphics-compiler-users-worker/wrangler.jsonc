{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "graphics-compiler-users-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-01-31",
	"observability": {
		"enabled": true
	},
	"vars": {
		"PROD_ORIGIN": "https://graphics-h-compiler.vercel.app"
	},
	"r2_buckets": [
		{
			"binding": "USER_FILES_BUCKET",
			"bucket_name": "graphics-compiler-users"
		}
	]
}
